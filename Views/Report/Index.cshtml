@model ExpenseTracker.Models.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "Monthly Report";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
}

<!-- Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-medium small">Month</label>
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.Month == m ? "selected" : null)">
                            @(new DateTime(2000, m, 1).ToString("MMMM"))
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-medium small">Year</label>
                <select name="year" class="form-select">
                    @foreach (var y in Model.AvailableYears)
                    {
                        <option value="@y" selected="@(Model.Year == y ? "selected" : null)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> View
                </button>
            </div>
            <div class="col-md-4 d-flex gap-2 justify-content-end">
                <a asp-action="ExportExcel" asp-route-month="@Model.Month" asp-route-year="@Model.Year"
                   class="btn btn-success btn-sm px-3">
                    <i class="fas fa-file-excel me-1"></i> Export Excel
                </a>
                <a asp-action="ExportPdf" asp-route-month="@Model.Month" asp-route-year="@Model.Year"
                   class="btn btn-danger btn-sm px-3">
                    <i class="fas fa-file-pdf me-1"></i> Export PDF
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-2 fw-bold text-danger">PKR @Model.GrandTotal.ToString("N2")</div>
            <div class="text-muted small">Total spent in @monthName</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-2 fw-bold text-primary">@Model.Expenses.Count</div>
            <div class="text-muted small">Total transactions</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-2 fw-bold text-success">
                @(Model.Expenses.Count > 0 ? $"PKR {(Model.GrandTotal / Model.Expenses.Count):N2}" : "N/A")
            </div>
            <div class="text-muted small">Average per transaction</div>
        </div>
    </div>
</div>

<!-- Category Breakdown -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 pt-3">
        <h6 class="fw-semibold mb-0"><i class="fas fa-chart-pie me-2 text-primary"></i>Category Breakdown</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.CategoryBreakdown.Any())
        {
            <div class="text-center text-muted py-4">No data for this period.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th class="text-center">Transactions</th>
                            <th class="text-end">Total</th>
                            <th style="width:200px">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CategoryBreakdown)
                        {
                            <tr>
                                <td>
                                    <span class="badge rounded-pill me-2" style="background-color:@item.Color">
                                        <i class="@item.Icon me-1"></i>@item.CategoryName
                                    </span>
                                </td>
                                <td class="text-center">@item.Count</td>
                                <td class="text-end fw-semibold">PKR @item.Total.ToString("N2")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:8px">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width:@item.Percentage%;background-color:@item.Color"
                                                 aria-valuenow="@item.Percentage" aria-valuemin="0" aria-valuemax="100">
                                            </div>
                                        </div>
                                        <small class="text-muted" style="width:38px">@item.Percentage%</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td class="fw-bold">Total</td>
                            <td class="text-center fw-bold">@Model.Expenses.Count</td>
                            <td class="text-end fw-bold text-danger">PKR @Model.GrandTotal.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

<!-- Expense Detail Table -->
@if (Model.Expenses.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="fw-semibold mb-0"><i class="fas fa-list me-2 text-secondary"></i>All Expenses in @monthName</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Notes</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Expenses)
                        {
                            <tr>
                                <td class="text-muted small">@e.Date.ToString("dd MMM")</td>
                                <td class="fw-medium">@e.Title</td>
                                <td>
                                    <span class="badge rounded-pill" style="background-color:@e.Category.Color">
                                        @e.Category.Name
                                    </span>
                                </td>
                                <td class="text-muted small">@(e.Notes ?? "-")</td>
                                <td class="text-end fw-semibold text-danger">PKR @e.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
