@model List<ExpenseTracker.Models.Category>

<div class="modal fade" id="quickAddModal" tabindex="-1" aria-labelledby="quickAddTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-controller="Expense" asp-action="Create" method="post" data-quick-add>
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="quickAddTitle"><i class="fas fa-plus-circle text-primary me-2"></i>Quick add expense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="qa-title" class="form-label fw-medium">Title</label>
                    <input id="qa-title" name="Title" class="form-control" maxlength="100" required placeholder="e.g. Lunch" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label for="qa-amount" class="form-label fw-medium">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">@Cur.Code</span>
                            <input id="qa-amount" name="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-6">
                        <label for="qa-date" class="form-label fw-medium">Date</label>
                        <input id="qa-date" name="Date" type="date" class="form-control" required />
                    </div>
                </div>
                <div class="mb-1">
                    <label for="qa-category" class="form-label fw-medium">Category</label>
                    <select id="qa-category" name="CategoryId" class="form-select" required>
                        <option value="">-- Select Category --</option>
                        @foreach (var c in Model)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save</button>
            </div>
        </form>
    </div>
</div>
