<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Expense Tracker</title>
    <script>document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('theme') || 'light');</script>
    <link rel="preload" href="~/vendor/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>

@if (User.Identity?.IsAuthenticated == true)
{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    <div class="d-flex" id="wrapper">
        <!-- ── Sidebar ── -->
        <nav id="sidebar" class="d-flex flex-column p-3 text-white" aria-label="Main navigation">
            <a href="/" class="d-flex align-items-center mb-4 text-white text-decoration-none">
                <i class="fas fa-wallet me-2 fs-4" aria-hidden="true"></i>
                <span class="fs-5 fw-bold">ExpenseTracker</span>
            </a>
            <hr class="text-white-50" />
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item mb-1">
                    <a asp-controller="Dashboard" asp-action="Index" data-tour="nav-dashboard"
                       class="nav-link text-white @(controller == "Dashboard" ? "active" : "")"
                       aria-current="@(controller == "Dashboard" ? "page" : null)">
                        <i class="fas fa-tachometer-alt me-2" aria-hidden="true"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Expense" asp-action="Index" data-tour="nav-expenses"
                       class="nav-link text-white @(controller == "Expense" ? "active" : "")"
                       aria-current="@(controller == "Expense" ? "page" : null)">
                        <i class="fas fa-receipt me-2" aria-hidden="true"></i> Expenses
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Category" asp-action="Index"
                       class="nav-link text-white @(controller == "Category" ? "active" : "")"
                       aria-current="@(controller == "Category" ? "page" : null)">
                        <i class="fas fa-tags me-2" aria-hidden="true"></i> Categories
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Budget" asp-action="Index" data-tour="nav-budgets"
                       class="nav-link text-white @(controller == "Budget" ? "active" : "")"
                       aria-current="@(controller == "Budget" ? "page" : null)">
                        <i class="fas fa-bullseye me-2" aria-hidden="true"></i> Budgets
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Report" asp-action="Index"
                       class="nav-link text-white @(controller == "Report" ? "active" : "")"
                       aria-current="@(controller == "Report" ? "page" : null)">
                        <i class="fas fa-chart-bar me-2" aria-hidden="true"></i> Reports
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Account" asp-action="Profile"
                       class="nav-link text-white @(controller == "Account" ? "active" : "")"
                       aria-current="@(controller == "Account" ? "page" : null)">
                        <i class="fas fa-user-cog me-2" aria-hidden="true"></i> Profile
                    </a>
                </li>
            </ul>
            <button type="button" class="btn btn-sm btn-outline-light w-100 mb-3 d-flex justify-content-between align-items-center"
                    data-open-palette>
                <span><i class="fas fa-search me-2" aria-hidden="true"></i>Quick search</span>
                <kbd class="small">Ctrl K</kbd>
            </button>
            <hr class="text-white-50" />
            <div class="d-flex align-items-center">
                <i class="fas fa-user-circle fs-4 me-2" aria-hidden="true"></i>
                <div class="lh-sm">
                    <span class="d-block small fw-semibold">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link p-0 text-white-50 small">
                            <i class="fas fa-sign-out-alt me-1" aria-hidden="true"></i>Logout
                        </button>
                    </form>
                </div>
            </div>
        </nav>
        <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

        <!-- ── Main Content ── -->
        <div id="page-content-wrapper" class="flex-grow-1">
            <!-- Top Navbar -->
            <header class="navbar navbar-expand-lg bg-body border-bottom px-4 py-2">
                <button class="btn btn-sm btn-outline-secondary me-3" id="sidebarToggle"
                        aria-label="Toggle sidebar" aria-controls="sidebar">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <span class="fw-semibold text-muted">@ViewData["Title"]</span>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="themeToggle"
                            title="Toggle dark mode" aria-label="Toggle dark mode">
                        <i class="fas fa-moon" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal"
                            data-bs-target="#quickAddModal" data-tour="add-expense">
                        <i class="fas fa-plus me-1" aria-hidden="true"></i> <span class="d-none d-sm-inline">Add Expense</span>
                    </button>
                </div>
            </header>

            <main id="main-content" class="container-fluid py-4 px-4" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Floating quick-add button (mobile) -->
    <button type="button" class="fab d-md-none" data-bs-toggle="modal" data-bs-target="#quickAddModal"
            aria-label="Add expense">
        <i class="fas fa-plus" aria-hidden="true"></i>
    </button>

    @await Component.InvokeAsync("QuickAdd")

    <!-- Command palette -->
    <div class="modal fade" id="paletteModal" tabindex="-1" aria-label="Quick search" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable palette-dialog">
            <div class="modal-content">
                <div class="p-3 border-bottom">
                    <input type="text" id="paletteInput" class="form-control form-control-lg border-0 shadow-none"
                           placeholder="Type a command or page…" autocomplete="off" role="combobox"
                           aria-expanded="true" aria-controls="paletteList" />
                </div>
                <div class="list-group list-group-flush palette-list" id="paletteList" role="listbox"></div>
                <div class="px-3 py-2 border-top text-muted small">
                    <kbd>↑</kbd> <kbd>↓</kbd> navigate · <kbd>Enter</kbd> select · <kbd>Esc</kbd> close
                </div>
            </div>
        </div>
    </div>

    <!-- Onboarding tour -->
    <div id="tourCard" class="tour-card d-none" role="dialog" aria-live="polite">
        <div class="fw-semibold mb-1" id="tourTitle"></div>
        <div class="small mb-3" id="tourText"></div>
        <div class="d-flex justify-content-between align-items-center">
            <button type="button" class="btn btn-sm btn-link text-muted p-0" id="tourSkip">Skip</button>
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted" id="tourStep"></span>
                <button type="button" class="btn btn-sm btn-primary" id="tourNext">Next</button>
            </div>
        </div>
    </div>
}
else
{
    <!-- Auth pages (no sidebar) -->
    <main id="main-content" class="auth-wrapper d-flex align-items-center justify-content-center min-vh-100 bg-light" tabindex="-1">
        @RenderBody()
    </main>
}

<!-- Toasts -->
<div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer" aria-live="polite">
    @if (TempData["Success"] != null)
    {
        <div class="toast align-items-center text-bg-success border-0" role="status" data-bs-delay="4000">
            <div class="d-flex">
                <div class="toast-body"><i class="fas fa-check-circle me-2" aria-hidden="true"></i>@TempData["Success"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast align-items-center text-bg-danger border-0" role="alert" data-bs-delay="6000">
            <div class="d-flex">
                <div class="toast-body"><i class="fas fa-exclamation-circle me-2" aria-hidden="true"></i>@TempData["Error"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="confirmDeleteTitle"><i class="fas fa-exclamation-triangle text-danger me-2" aria-hidden="true"></i>Confirm delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmDeleteMessage">Are you sure?</div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><i class="fas fa-trash me-1" aria-hidden="true"></i>Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.APP = {
        currency: '@(User.Identity?.IsAuthenticated == true ? Cur.Code : "PKR")',
        urls: {
            dashboard: '@Url.Action("Index", "Dashboard")',
            expenses: '@Url.Action("Index", "Expense")',
            addExpense: '@Url.Action("Create", "Expense")',
            categories: '@Url.Action("Index", "Category")',
            newCategory: '@Url.Action("Create", "Category")',
            budgets: '@Url.Action("Index", "Budget")',
            reports: '@Url.Action("Index", "Report")',
            profile: '@Url.Action("Profile", "Account")',
            password: '@Url.Action("ChangePassword", "Account")'
        }
    };
</script>
<script src="~/vendor/bootstrap/bootstrap.bundle.min.js"></script>
<script src="~/vendor/chartjs/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
