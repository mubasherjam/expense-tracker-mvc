@model ExpenseTracker.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-semibold mb-0">
                    <i class="fas fa-edit text-primary me-2"></i>Edit Category
                </h5>
            </div>
            <div class="card-body px-4 pb-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-medium"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Color" class="form-label fw-medium">Color</label>
                        <input asp-for="Color" type="color" class="form-control form-control-color"
                               style="width:60px;height:40px" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Icon" class="form-label fw-medium">Icon</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i id="icon-el" class="@Model.Icon"></i>
                            </span>
                            <input asp-for="Icon" class="form-control" id="icon-input" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Update
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('icon-input').addEventListener('input', function () {
        document.getElementById('icon-el').className = this.value;
    });
</script>
}
