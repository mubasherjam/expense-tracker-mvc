@model IEnumerable<ExpenseTracker.Models.Expense>
@{
    ViewData["Title"] = "Expenses";
}

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-medium">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                           placeholder="Title or notes..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-medium">Category</label>
                <select name="categoryId" asp-items="@((SelectList)ViewBag.Categories)" class="form-select">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-medium">Month</label>
                <input type="month" name="month" value="@ViewBag.Month" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear">
                    <i class="fas fa-times"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-3">
        <div>
            <h6 class="fw-semibold mb-0">All Expenses</h6>
            <small class="text-muted">@Model.Count() records found</small>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Add New
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-receipt fs-1 mb-2 d-block"></i>
                No expenses found.
                <a asp-action="Create">Add your first expense!</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Notes</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model)
                        {
                            <tr>
                                <td class="fw-medium">@expense.Title</td>
                                <td>
                                    <span class="badge rounded-pill"
                                          style="background-color:@expense.Category.Color">
                                        <i class="@expense.Category.Icon me-1"></i>@expense.Category.Name
                                    </span>
                                </td>
                                <td class="text-muted small">@expense.Date.ToString("dd MMM yyyy")</td>
                                <td class="text-muted small">@(expense.Notes?.Length > 40 ? expense.Notes[..40] + "…" : expense.Notes ?? "-")</td>
                                <td class="text-end fw-semibold text-danger">PKR @expense.Amount.ToString("N2")</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@expense.Id"
                                       class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@expense.Id" method="post" class="d-inline"
                                          data-confirm="Delete the expense '@expense.Title'? This cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="fw-bold">Total</td>
                            <td class="text-end fw-bold text-danger">PKR @Model.Sum(e => e.Amount).ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
