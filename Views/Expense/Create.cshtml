@model ExpenseTracker.Models.ViewModels.ExpenseViewModel

@{
    ViewData["Title"] = "Add Expense";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <!-- Page Heading -->
            <div class="mb-4">
                <a asp-action="Index"
                   class="text-decoration-none text-muted small">
                    <i class="fas fa-arrow-left me-2"></i>Back to Expenses
                </a>

                <h3 class="fw-bold mt-3 mb-1">Add New Expense</h3>
                <p class="text-muted mb-0">
                    Record your spending and keep your finances organized.
                </p>
            </div>

            <!-- Expense Card -->
            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <!-- Card Header -->
                <div class="p-4 text-white"
                     style="background: linear-gradient(135deg, #2563eb, #4f46e5);">

                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-25 rounded-3 p-3">
                            <i class="fas fa-wallet fa-lg"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Expense Details</h5>
                            <small class="text-white-50">
                                Fill in the information below
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Form Body -->
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger small"
                             role="alert"></div>

                        <!-- Expense Title -->
                        <div class="mb-4">
                            <label asp-for="Title"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-pen text-muted"></i>
                                </span>

                                <input asp-for="Title"
                                       class="form-control border-start-0 ps-0"
                                       placeholder="e.g. Lunch at restaurant" />
                            </div>

                            <span asp-validation-for="Title"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Amount and Date -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">
                                <label asp-for="Amount"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-semibold">
                                        @Cur.Code
                                    </span>

                                    <input asp-for="Amount"
                                           class="form-control fw-semibold"
                                           placeholder="0.00"
                                           type="number"
                                           step="0.01"
                                           min="0.01" />
                                </div>

                                <span asp-validation-for="Amount"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Date"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="far fa-calendar-alt text-muted"></i>
                                    </span>

                                    <input asp-for="Date"
                                           class="form-control border-start-0"
                                           type="date" />
                                </div>

                                <span asp-validation-for="Date"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <!-- Category -->
                        <div class="mb-4">
                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-layer-group text-muted"></i>
                                </span>

                                <select asp-for="CategoryId"
                                        asp-items="Model.Categories"
                                        class="form-select border-start-0">
                                    <option value="">Select a category</option>
                                </select>
                            </div>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Notes -->
                        <div class="mb-4">
                            <label asp-for="Notes"
                                   class="form-label fw-semibold">
                                Notes
                                <span class="text-muted fw-normal small">
                                    (Optional)
                                </span>
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Add any additional details about this expense..."></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger small"></span>
                        </div>

                        <hr class="my-4">

                        <!-- Actions -->
                        <div class="d-flex flex-column flex-sm-row gap-3">

                            <button type="submit"
                                    class="btn btn-primary px-4 py-2 rounded-3 fw-semibold">
                                <i class="fas fa-check-circle me-2"></i>
                                Save Expense
                            </button>

                            <a asp-action="Index"
                               class="btn btn-light border px-4 py-2 rounded-3 fw-semibold">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

            <!-- Helper Text -->
            <div class="text-center mt-4">
                <small class="text-muted">
                    <i class="fas fa-shield-alt me-1"></i>
                    Your expense records are securely managed.
                </small>
            </div>

        </div>
    </div>
</div>

<style>
    .card {
        transition: box-shadow 0.25s ease;
    }

    .form-control,
    .form-select,
    .input-group-text {
        min-height: 46px;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
    }

    .input-group > .input-group-text {
        border-radius: 8px 0 0 8px;
    }

    .input-group > .form-control,
    .input-group > .form-select {
        border-radius: 0 8px 8px 0;
    }

    textarea.form-control {
        min-height: 100px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.12);
    }

    .btn {
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }
</style>
