@model ExpenseTracker.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="card shadow-sm border-0" style="width:400px">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <i class="fas fa-wallet fs-1 text-primary"></i>
            <h4 class="mt-2 fw-bold">Welcome Back!</h4>
            <p class="text-muted small">Sign in to your account</p>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-medium"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-medium"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="Your password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="fas fa-sign-in-alt me-1"></i> Sign In
            </button>
        </form>

        <hr class="my-3" />
        <p class="text-center text-muted small mb-0">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register" class="text-primary fw-medium">Create one</a>
        </p>
    </div>
</div>
