@model ExpenseTracker.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="card shadow-sm border-0" style="width:420px">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <i class="fas fa-wallet fs-1 text-primary"></i>
            <h4 class="mt-2 fw-bold">ExpenseTracker</h4>
            <p class="text-muted small">Create your free account</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-medium"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user text-muted"></i></span>
                    <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-medium"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-medium"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="Min 6 characters" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-medium"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="fas fa-user-plus me-1"></i> Create Account
            </button>
        </form>

        <hr class="my-3" />
        <p class="text-center text-muted small mb-0">
            Already have an account?
            <a asp-controller="Account" asp-action="Login" class="text-primary fw-medium">Sign In</a>
        </p>
    </div>
</div>
